# Netlify Functions (runtime — never commit real values)
TEACHING_HUB_PASSPHRASE_HASH=
SESSION_SECRET=
SITE_ORIGIN=https://teaching-hub.adam-russell.com

# Optional: bake the Functions origin into the Pages build (no trailing slash).
# If unset, src/api/config.ts falls back to a placeholder until you set this
# or edit the committed default after the first Netlify deploy.
# VITE_API_BASE_URL=https://teaching-api.adam-russell.com

# Optional — html_app AI lane proxy (Netlify Functions only; never commit real values)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Public-web grounding for every lesson AI turn (Netlify Functions only; keep secret)
# BRAVE_SEARCH_API_KEY=

# Optional — GitHub content snapshots (Netlify Functions only; never commit real values)
# Trash “Backup to GitHub” plus a weekly Netlify schedule (Sunday 00:00 UTC). Not after every edit.
# GITHUB_BACKUP_TOKEN=
# GITHUB_BACKUP_REPO=owner/repo
# GITHUB_BACKUP_BRANCH=main

# Clementine archive (Netlify Functions only — never in the browser)
# Same RESEARCH_KERNEL_SHARED_SECRET as Knowledge Hub / the Worker.
# RESEARCH_KERNEL_SHARED_SECRET=
# RESEARCH_KERNEL_URL=https://knowledge-hub-research.adamrussell91.workers.dev
